<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme while the process is starting. Woofer is dark-only, so this
         uses a black-based parent even when the OS is in light mode — a Light
         parent flashed white between the splash and the Flutter UI. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Removed automatically when the Flutter engine draws its first frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window theme once the process has started: the colour behind the Flutter
         UI while it initialises. Brand ground, so the handoff is seamless. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/brand_ground</item>
    </style>
</resources>
